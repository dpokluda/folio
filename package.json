{
  "name": "folio",
  "version": "1.0.0",
  "description": "A lightweight, themeable Markdown editor & viewer with a Typora-like look — edit the source, preview it rendered, swap CSS themes (Typora-theme compatible).",
  "main": "src/main.js",
  "author": {
    "name": "David Pokluda",
    "email": "david@pokluda.cz"
  },
  "license": "MIT",
  "homepage": "https://github.com/dpokluda/Folio",
  "repository": {
    "type": "git",
    "url": "https://github.com/dpokluda/Folio.git"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "ensure:electron": "node scripts/ensure-electron.js",
    "build:renderer": "node build.js",
    "watch:renderer": "node build.js --watch",
    "start": "npm run ensure:electron && npm run build:renderer && electron .",
    "icons": "node scripts/generate-icons.js",
    "clean:release": "node scripts/clean-release.js",
    "dist": "npm run ensure:electron && npm run build:renderer && npm run clean:release && node scripts/run-electron-builder.js",
    "dist:win": "npm run ensure:electron && npm run build:renderer && npm run clean:release && node scripts/run-electron-builder.js --win",
    "dist:mac": "npm run ensure:electron && npm run build:renderer && npm run clean:release && node scripts/run-electron-builder.js --mac",
    "dist:linux": "npm run ensure:electron && npm run build:renderer && npm run clean:release && node scripts/run-electron-builder.js --linux"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.29.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.1",
    "dompurify": "^3.1.6",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@electron/asar": "3.4.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "png2icons": "^2.0.1",
    "semver": "7.8.5",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.dpokluda.folio",
    "productName": "Folio",
    "files": [
      "src/**/*",
      "themes/**/*",
      "samples/**/*",
      "build/icons/**",
      "!themes/word/fonts/**/*.[tT][tT][fF]",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "themes",
        "to": "themes",
        "filter": [
          "**/*",
          "!**/fonts/**/*.[tT][tT][fF]"
        ]
      },
      {
        "from": "docs/user/README.md",
        "to": "README.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "directories": {
      "output": "release"
    },
    "artifactBuildCompleted": "scripts/add-mac-archive-readme.js",
    "afterAllArtifactBuild": "scripts/build-inno-installer.js",
    "win": {
      "target": "zip",
      "artifactName": "${productName}-${version}-windows-${arch}.${ext}",
      "icon": "build/icons/icon.ico",
      "extraFiles": [
        {
          "from": "docs/user/README.md",
          "to": "README.md"
        }
      ],
      "extraResources": [
        {
          "from": "build/icons/document.ico",
          "to": "document.ico"
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown",
            "mkd",
            "mkdn"
          ],
          "name": "Folio.Markdown",
          "description": "Markdown Document",
          "mimeType": "text/markdown",
          "role": "Editor",
          "icon": "build/icons/document.ico"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "tar.gz"
      ],
      "artifactName": "${productName}-${version}-macos-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "extraResources": [
        {
          "from": "build/icons/document.icns",
          "to": "document.icns"
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown Document",
            "CFBundleTypeRole": "Editor",
            "CFBundleTypeIconFile": "document.icns",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "net.daringfireball.markdown",
              "public.plain-text"
            ]
          },
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "None",
            "LSItemContentTypes": [
              "public.folder"
            ]
          }
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz",
        "deb"
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "category": "Office",
      "icon": "build/icons/icon.png",
      "extraFiles": [
        {
          "from": "docs/user/README.md",
          "to": "README.md"
        }
      ]
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
