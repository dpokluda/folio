{
  "name": "folio",
  "version": "0.1.0",
  "description": "A lightweight, themeable Markdown editor & viewer with a Typora-like look — edit the source, preview it rendered, swap CSS themes (Typora-theme compatible).",
  "main": "src/main.js",
  "author": {
    "name": "David Pokluda",
    "email": "david@pokluda.cz"
  },
  "license": "MIT",
  "homepage": "https://github.com/dpokluda/Folio",
  "repository": {
    "type": "git",
    "url": "https://github.com/dpokluda/Folio.git"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "ensure:electron": "node scripts/ensure-electron.js",
    "build:renderer": "node build.js",
    "watch:renderer": "node build.js --watch",
    "start": "npm run ensure:electron && npm run build:renderer && electron .",
    "icons": "node scripts/generate-icons.js",
    "prepare:wincodesign": "node scripts/prepare-wincodesign.js",
    "clean:release": "node scripts/clean-release.js",
    "dist": "npm run ensure:electron && npm run build:renderer && npm run prepare:wincodesign && npm run clean:release && node scripts/run-electron-builder.js",
    "dist:win": "npm run ensure:electron && npm run build:renderer && npm run prepare:wincodesign && npm run clean:release && node scripts/run-electron-builder.js --win",
    "dist:mac": "npm run ensure:electron && npm run build:renderer && npm run clean:release && node scripts/run-electron-builder.js --mac",
    "dist:linux": "npm run ensure:electron && npm run build:renderer && npm run clean:release && node scripts/run-electron-builder.js --linux"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.29.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "codemirror": "^6.0.1",
    "dompurify": "^3.1.6",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.23.0",
    "png2icons": "^2.0.1",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.dpokluda.folio",
    "productName": "Folio",
    "files": [
      "src/**/*",
      "themes/**/*",
      "samples/**/*",
      "build/icons/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "themes",
        "to": "themes",
        "filter": [
          "**/*",
          "!**/fonts/*.ttf"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icons/icon.ico",
      "fileAssociations": [
        {
          "ext": ["md", "markdown", "mdown", "mkd", "mkdn"],
          "name": "Folio.Markdown",
          "description": "Markdown Document",
          "mimeType": "text/markdown",
          "role": "Editor",
          "icon": "build/icons/document.ico"
        }
      ]
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icons/icon.icns",
      "extraResources": [
        {
          "from": "build/icons/document.icns",
          "to": "document.icns"
        }
      ],
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown Document",
            "CFBundleTypeRole": "Editor",
            "CFBundleTypeIconFile": "document.icns",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["net.daringfireball.markdown", "public.plain-text"]
          },
          {
            "CFBundleTypeName": "Folder",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "None",
            "LSItemContentTypes": ["public.folder"]
          }
        ]
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icons/icon.png"
    }
  }
}
